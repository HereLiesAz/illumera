<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <!-- OpenVPN VpnService is kept private to this APK and only started after consent. -->
        <service android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
        <service android:name="de.blinkt.openvpn.core.OpenVPNStatusService"
            android:exported="false"/>
        <service android:name="de.blinkt.openvpn.core.keepVPNAlive"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
    </application>
</manifest>
