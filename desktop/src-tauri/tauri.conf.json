{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illumera",
  "version": "0.1.0",
  "identifier": "com.hereliesaz.illumera.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web ci && npm --prefix ../web run build",
    "beforeDevCommand": "npm --prefix ../web run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "illumera",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#000000",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' https: data: blob:",
        "media-src": "'self' https: http://127.0.0.1:* blob:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/torrserver"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Stream from Stremio addons",
    "longDescription": "illumera for the desktop: browse, search and play from Stremio-compatible addons, with torrents through a bundled TorrServer."
  }
}
